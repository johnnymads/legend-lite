{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "noImplicitReturns": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "noEmit": true, "skipLibCheck": true
  },
  "include": ["tile-layout.ts", "tile-layout.test.ts"]
}
