# The query store (README.md): upstream's saved-query records, ONE typed client over a fetch, and the
# same /api/pure/v1/query answered in the page from IndexedDB. Plain TypeScript with no npm
# dependency, for every app here that saves or opens queries (Query writes, DataCube reads).
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")

js_library(
    name = "query_store",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    visibility = ["//visibility:public"],
)

_NODE_OPTIONS = [
    "--experimental-strip-types",
    "--disable-warning=ExperimentalWarning",
    "--test-reporter=spec",
    "--test-reporter-destination=stdout",
    "--test-reporter=../datacube/test/strict-reporter.mjs",
    "--test-reporter-destination=stderr",
]

# The one suite against the page's own store.
js_test(
    name = "local_test",
    size = "small",
    chdir = package_name(),
    data = [
        ":query_store",
        "test/conformance.ts",
        "test/local.test.ts",
        "//datacube:strict_reporter",
    ],
    entry_point = "test/local.test.ts",
    node_options = _NODE_OPTIONS,
)

# The same suite against legend-lite's server, started here with a fresh store.
js_test(
    name = "lite_test",
    size = "small",
    chdir = package_name(),
    data = [
        ":query_store",
        "test/conformance.ts",
        "test/lite.test.ts",
        "//core:server",
        "//datacube:strict_reporter",
    ],
    entry_point = "test/lite.test.ts",
    node_options = _NODE_OPTIONS,
)

# Every TypeScript file here, for the apps' typechecks (strict tsc: no npm dependency of its own).
js_library(
    name = "typescript_sources",
    srcs = glob(["src/**/*.ts", "test/**/*.ts"]) + ["package.json"],
    visibility = [
        "//datacube:__pkg__",
        "//query:__pkg__",
    ],
)
