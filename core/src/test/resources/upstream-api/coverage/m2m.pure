// Adapted from legend-engine's core_analytics_mapping/modelCoverage/analyticsTest.pure
// (sampleModelToModelMapping): Pure (M2M) sets, a union of Pure sets, a primitive
// property auto-mapped from the source class.
###Pure
Enum test::coverage::IncType
{
  Corp,
  LLC
}

Class test::coverage::LegalEntity
{
  legalName: String[1];
  address: test::coverage::Address[1];
}

Class test::coverage::Firm extends test::coverage::LegalEntity
{
  id: Decimal[1];
  employees: test::coverage::Person[1..*];
  incType: test::coverage::IncType[1];
}

Class test::coverage::Person
{
  firstName: String[1];
  lastName: String[1];
}

Class test::coverage::Address
{
  zipcode: Integer[1];
}

Class test::coverage::Street extends test::coverage::Address
{
  streetName: String[1];
}

Class test::coverage::_LegalEntity
{
  legalName: String[1];
  address: test::coverage::Address[1];
}

Class test::coverage::_Firm
{
  id: Decimal[1];
  employees: test::coverage::_Person[1..*];
  type: test::coverage::IncType[1];
}

Class test::coverage::_Person
{
  fullName: String[1];
}

Class test::coverage::_Street
{
  streetName: String[1];
}

###Mapping
Mapping test::coverage::sampleModelToModelMapping
(
  test::coverage::_Person: Pure
  {
    ~src test::coverage::Person
    fullName: 'Full Name'
  }
  test::coverage::_LegalEntity: Pure
  {
    ~src test::coverage::LegalEntity
    legalName: $src.legalName
  }
  test::coverage::_Firm: Pure
  {
    ~src test::coverage::Firm
    employees: $src.employees
  }
  *test::coverage::_Street: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(s1,s2)
  }
  test::coverage::_Street[s2]: Pure
  {
    ~src test::coverage::Street
    streetName: $src.streetName + '2'
  }
  test::coverage::_Street[s1]: Pure
  {
    ~src test::coverage::Street
    streetName: $src.streetName + '1'
  }
)
