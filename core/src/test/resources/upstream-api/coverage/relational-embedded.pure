// Embedded, inline-embedded and otherwise-embedded property mappings, nested
// embedding, a join to a class with no set, a non-root set declared before an
// embedding owner, set ids routed per property, and an extends set.
###Relational
Database test::coverage::EmbDB
(
  Table FIRM
  (
    ID INTEGER PRIMARY KEY,
    LEGAL_NAME VARCHAR(200),
    CEO_FIRST VARCHAR(200),
    CEO_LAST VARCHAR(200),
    CEO_STREET VARCHAR(200),
    CEO_ZIP INTEGER,
    ADDR_ID INTEGER
  )
  Table PERSON
  (
    ID INTEGER PRIMARY KEY,
    FIRM_ID INTEGER,
    FIRST_NAME VARCHAR(200),
    LAST_NAME VARCHAR(200),
    KIND VARCHAR(10)
  )
  Table ADDRESS
  (
    ID INTEGER PRIMARY KEY,
    STREET VARCHAR(200),
    ZIP INTEGER
  )
  Join FirmPerson(PERSON.FIRM_ID = FIRM.ID)
  Join FirmAddress(FIRM.ADDR_ID = ADDRESS.ID)
)

###Pure
Class test::coverage::Address
{
  street: String[1];
  zip: Integer[0..1];
}

Class test::coverage::Person
{
  firstName: String[1];
  lastName: String[1];
  home: test::coverage::Address[0..1];
}

Class test::coverage::Manager extends test::coverage::Person
{
  reports: Integer[0..1];
}

Class test::coverage::Unmapped
{
  name: String[1];
}

Class test::coverage::Firm
{
  id: Integer[1];
  legalName: String[1];
  ceo: test::coverage::Person[0..1];
  hq: test::coverage::Address[0..1];
  office: test::coverage::Address[0..1];
  staff: test::coverage::Person[*];
  other: test::coverage::Unmapped[0..1];
}

###Mapping
Mapping test::coverage::EmbeddedMapping
(
  test::coverage::Address[addr2]: Relational
  {
    ~mainTable [test::coverage::EmbDB]ADDRESS
    street: [test::coverage::EmbDB]ADDRESS.STREET
  }
  *test::coverage::Address[addr]: Relational
  {
    ~mainTable [test::coverage::EmbDB]ADDRESS
    street: [test::coverage::EmbDB]ADDRESS.STREET,
    zip: [test::coverage::EmbDB]ADDRESS.ZIP
  }
  *test::coverage::Firm: Relational
  {
    ~mainTable [test::coverage::EmbDB]FIRM
    id: [test::coverage::EmbDB]FIRM.ID,
    legalName: [test::coverage::EmbDB]FIRM.LEGAL_NAME,
    ceo
    (
      firstName: [test::coverage::EmbDB]FIRM.CEO_FIRST,
      lastName: [test::coverage::EmbDB]FIRM.CEO_LAST,
      home
      (
        street: [test::coverage::EmbDB]FIRM.CEO_STREET,
        zip: [test::coverage::EmbDB]FIRM.CEO_ZIP
      )
    ),
    hq[addr]: [test::coverage::EmbDB]@FirmAddress,
    office[addr2]: [test::coverage::EmbDB]@FirmAddress,
    staff[person]: [test::coverage::EmbDB]@FirmPerson,
    other: [test::coverage::EmbDB]@FirmPerson
  }
  *test::coverage::Person[person]: Relational
  {
    ~mainTable [test::coverage::EmbDB]PERSON
    firstName: [test::coverage::EmbDB]PERSON.FIRST_NAME,
    lastName: [test::coverage::EmbDB]PERSON.LAST_NAME
  }
  *test::coverage::Manager extends [person]: Relational
  {
    ~mainTable [test::coverage::EmbDB]PERSON
    reports: [test::coverage::EmbDB]PERSON.ID
  }
)
