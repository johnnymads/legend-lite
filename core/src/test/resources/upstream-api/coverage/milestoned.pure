// A milestoned (business-temporal) class: legend-lite refuses the analysis (the engine's
// generated milestoning and edge-point properties are not modelled).
###Relational
Database test::coverage::MilDB
(
  Table PRODUCT
  (
    milestoning(business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z))
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(200),
    FROM_Z DATE,
    THRU_Z DATE
  )
)

###Pure
Class <<meta::pure::profiles::temporal.businesstemporal>> test::coverage::Product
{
  id: Integer[1];
  name: String[1];
}

###Mapping
Mapping test::coverage::MilestonedMapping
(
  *test::coverage::Product: Relational
  {
    ~mainTable [test::coverage::MilDB]PRODUCT
    id: [test::coverage::MilDB]PRODUCT.ID,
    name: [test::coverage::MilDB]PRODUCT.NAME
  }
)
