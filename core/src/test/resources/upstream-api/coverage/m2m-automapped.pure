// Adapted from legend-engine's analyticsTest.pure (testCyclicalAutoMappedComplexPropertiesMappingCoverage):
// a class-typed Pure property mapping whose target class has no set is AUTO-MAPPED
// (the engine walks the source graph, cycle-safe).
###Pure
Class test::coverage::Target
{
  tgtId: String[1];
  shared: test::coverage::Shared[1];
  sharedB: test::coverage::Shared[1];
}
Class test::coverage::Shared
{
  sharedId: String[1];
  sharedToAddress: test::coverage::Address[1];
}
Class test::coverage::Address
{
  Id: String[1];
  addressToShared: test::coverage::Shared[1];
}
Class test::coverage::Source
{
  srcId: String[1];
  shared: test::coverage::Shared[1];
  sharedB: test::coverage::Shared[1];
}
###Mapping
Mapping test::coverage::autoMappedMapping
(
  *test::coverage::Target: Pure
  {
    ~src test::coverage::Source
    tgtId: $src.srcId,
    shared: $src.shared,
    sharedB: $src.sharedB
  }
)
