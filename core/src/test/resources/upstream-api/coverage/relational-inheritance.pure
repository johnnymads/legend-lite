// Adapted from legend-engine's core_analytics_mapping/modelCoverage/analyticsTest.pure
// (sampleRelationalMapping): Operation inheritance and union sets, an embedded
// property, an enumeration mapping and qualified properties.
###Relational
Database test::coverage::sampleDB
(
  Table FirmTable
  (
    id INTEGER PRIMARY KEY,
    legalName VARCHAR(200),
    incType VARCHAR(10)
  )
  Table PersonTable
  (
    id INTEGER PRIMARY KEY,
    firmID INTEGER,
    firstName VARCHAR(200),
    lastName VARCHAR(200)
  )
  Table AddressTable
  (
    id INTEGER PRIMARY KEY,
    firmID INTEGER,
    name VARCHAR(200)
  )

  Join firm_person(PersonTable.firmID = FirmTable.id)
  Join firm_address(AddressTable.firmID = FirmTable.id)
)

###Pure
Enum test::coverage::IncType
{
  Corp,
  LLC
}

Class test::coverage::LegalEntity
{
  legalName: String[1];
  address: test::coverage::Address[1];
}

Class test::coverage::Firm extends test::coverage::LegalEntity
{
  id: Decimal[1];
  employees: test::coverage::Person[1..*];
  incType: test::coverage::IncType[1];
  incType2: test::coverage::IncType[0..1];
  derivedIncType() {if(
  $this.incType2->isNotEmpty(),
    |$this.incType2->toOne(),
    |$this.incType
  )}: test::coverage::IncType[1];
  employeeSize() {$this.employees->count()}: Number[1];
}

Class test::coverage::Person
{
  firstName: String[1];
  lastName: String[1];
}

Class test::coverage::Address
{
  zipcode: Integer[1];
}

Class test::coverage::Street extends test::coverage::Address
{
  streetName: String[1];
}

###Mapping
Mapping test::coverage::sampleRelationalMapping
(
  *test::coverage::Firm: Relational
  {
    ~primaryKey
    (
      [test::coverage::sampleDB]FirmTable.id
    )
    ~mainTable [test::coverage::sampleDB]FirmTable
    id: [test::coverage::sampleDB]FirmTable.id,
    incType: EnumerationMapping IncTypeMapping: [test::coverage::sampleDB]FirmTable.incType,
    employees
    (
      firstName: [test::coverage::sampleDB]PersonTable.firstName
    ),
    address: [test::coverage::sampleDB]@firm_address
  }
  test::coverage::IncType: EnumerationMapping IncTypeMapping
  {
    LLC: ['llc'],
    Corp: ['corp']
  }
  *test::coverage::Person: Relational
  {
    ~primaryKey
    (
      [test::coverage::sampleDB]PersonTable.id
    )
    ~mainTable [test::coverage::sampleDB]PersonTable
    firstName: [test::coverage::sampleDB]PersonTable.firstName,
    lastName: [test::coverage::sampleDB]PersonTable.lastName
  }
  *test::coverage::LegalEntity: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_()
  }
  *test::coverage::Address: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_()
  }
  *test::coverage::Street: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(s1,s2)
  }
  test::coverage::Street[s2]: Relational
  {
    ~primaryKey
    (
      [test::coverage::sampleDB]AddressTable.id
    )
    ~mainTable [test::coverage::sampleDB]AddressTable
    zipcode: [test::coverage::sampleDB]AddressTable.id
  }
  test::coverage::Street[s1]: Relational
  {
    ~primaryKey
    (
      [test::coverage::sampleDB]AddressTable.id
    )
    ~mainTable [test::coverage::sampleDB]AddressTable
    zipcode: [test::coverage::sampleDB]AddressTable.id
  }
)
