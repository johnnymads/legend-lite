// One property mapped to several sets (the engine's multi-property mapping): the
// targets match an inheritance Operation exactly, or only a part of it (the engine
// then builds a "<ids>@<class>" inheritance entity); subclass sets under an
// inheritance Operation, a union whose members map a class-typed property.
###Relational
Database test::coverage::VDB
(
  Table OWNER
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(200)
  )
  Table CAR
  (
    ID INTEGER PRIMARY KEY,
    OWNER_ID INTEGER,
    WHEELS INTEGER,
    DOORS INTEGER
  )
  Table BIKE
  (
    ID INTEGER PRIMARY KEY,
    OWNER_ID INTEGER,
    WHEELS INTEGER,
    GEARS INTEGER
  )
  Table BOAT
  (
    ID INTEGER PRIMARY KEY,
    OWNER_ID INTEGER,
    SAILS INTEGER
  )
  Join OwnerCar(CAR.OWNER_ID = OWNER.ID)
  Join OwnerBike(BIKE.OWNER_ID = OWNER.ID)
  Join OwnerBoat(BOAT.OWNER_ID = OWNER.ID)
)

###Pure
Class test::coverage::Vehicle
{
  id: Integer[1];
  owner: test::coverage::Owner[0..1];
  describe() {'vehicle ' + $this.id->toString()}: String[1];
}

Class test::coverage::RoadVehicle extends test::coverage::Vehicle
{
  wheels: Integer[1];
}

Class test::coverage::Car extends test::coverage::RoadVehicle
{
  doors: Integer[1];
}

Class test::coverage::Bike extends test::coverage::RoadVehicle
{
  gears: Integer[1];
}

Class test::coverage::Boat extends test::coverage::Vehicle
{
  sails: Integer[1];
}

Class test::coverage::Owner
{
  name: String[1];
  vehicles: test::coverage::Vehicle[*];
  roadVehicles: test::coverage::RoadVehicle[*];
  someVehicles: test::coverage::Vehicle[*];
  favorite: test::coverage::Vehicle[0..1];
  firstVehicle() {$this.vehicles->first()}: test::coverage::Vehicle[0..1];
  vehicleCount(min: Integer[1]) {$this.vehicles->size() + $min}: Integer[1];
  me() {$this}: test::coverage::Owner[1];
}

###Mapping
Mapping test::coverage::MultiMapping
(
  *test::coverage::Owner: Relational
  {
    ~mainTable [test::coverage::VDB]OWNER
    name: [test::coverage::VDB]OWNER.NAME,
    vehicles[car]: [test::coverage::VDB]@OwnerCar,
    vehicles[bike]: [test::coverage::VDB]@OwnerBike,
    vehicles[boat]: [test::coverage::VDB]@OwnerBoat,
    roadVehicles[car]: [test::coverage::VDB]@OwnerCar,
    roadVehicles[bike]: [test::coverage::VDB]@OwnerBike,
    someVehicles[car]: [test::coverage::VDB]@OwnerCar,
    someVehicles[boat]: [test::coverage::VDB]@OwnerBoat,
    favorite[car]: [test::coverage::VDB]@OwnerCar
  }
  *test::coverage::Vehicle: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_()
  }
  *test::coverage::RoadVehicle: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_()
  }
  *test::coverage::Car[car]: Relational
  {
    ~mainTable [test::coverage::VDB]CAR
    id: [test::coverage::VDB]CAR.ID,
    wheels: [test::coverage::VDB]CAR.WHEELS,
    doors: [test::coverage::VDB]CAR.DOORS,
    owner: [test::coverage::VDB]@OwnerCar
  }
  *test::coverage::Bike[bike]: Relational
  {
    ~mainTable [test::coverage::VDB]BIKE
    id: [test::coverage::VDB]BIKE.ID,
    wheels: [test::coverage::VDB]BIKE.WHEELS,
    gears: [test::coverage::VDB]BIKE.GEARS
  }
  *test::coverage::Boat[boat]: Relational
  {
    ~mainTable [test::coverage::VDB]BOAT
    id: [test::coverage::VDB]BOAT.ID,
    sails: [test::coverage::VDB]BOAT.SAILS,
    owner: [test::coverage::VDB]@OwnerBoat
  }
)
