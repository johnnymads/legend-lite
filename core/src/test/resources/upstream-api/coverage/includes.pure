// Included mappings: sets and association mappings of an included mapping, a class with
// a root set in both the included and the including mapping (the analysis re-roots it),
// a qualified property declared on an association, and an M2M set auto-mapping a
// primitive property from its source class.
###Relational
Database test::coverage::IncDB
(
  Table PERSON
  (
    ID INTEGER PRIMARY KEY,
    FIRM_ID INTEGER,
    NAME VARCHAR(200),
    AGE INTEGER
  )
  Table FIRM
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(200)
  )
  Join PersonFirm(PERSON.FIRM_ID = FIRM.ID)
)

###Pure
Enum test::coverage::Size
{
  SMALL,
  LARGE
}

Class test::coverage::Person
{
  name: String[1];
  age: Integer[0..1];
}

Class test::coverage::Firm
{
  name: String[1];
  size: test::coverage::Size[0..1];
}

Association test::coverage::Employment
{
  employer: test::coverage::Firm[0..1];
  employees: test::coverage::Person[*];
  employeesNamed(n: String[1]) {$this.employees->filter(e | $e.name == $n)}: test::coverage::Person[*];
}

Class test::coverage::PersonView
{
  label: String[1];
  age: Integer[0..1];
}

###Mapping
Mapping test::coverage::BaseMapping
(
  *test::coverage::Person[p]: Relational
  {
    ~mainTable [test::coverage::IncDB]PERSON
    name: [test::coverage::IncDB]PERSON.NAME,
    age: [test::coverage::IncDB]PERSON.AGE
  }
  test::coverage::Firm[f]: Relational
  {
    ~mainTable [test::coverage::IncDB]FIRM
    name: [test::coverage::IncDB]FIRM.NAME
  }
  test::coverage::Employment: Relational
  {
    AssociationMapping
    (
      employer[p, f]: [test::coverage::IncDB]@PersonFirm,
      employees[f, p]: [test::coverage::IncDB]@PersonFirm
    )
  }
)

Mapping test::coverage::MainMapping
(
  include test::coverage::BaseMapping

  *test::coverage::Firm[f2]: Relational
  {
    ~mainTable [test::coverage::IncDB]FIRM
    name: [test::coverage::IncDB]FIRM.NAME,
    size: EnumerationMapping SizeMapping: [test::coverage::IncDB]FIRM.NAME
  }
  test::coverage::Size: EnumerationMapping SizeMapping
  {
    SMALL: ['s'],
    LARGE: ['l']
  }
  *test::coverage::PersonView[pv]: Pure
  {
    ~src test::coverage::Person
    label: $src.name
  }
)
