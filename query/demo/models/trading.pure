// The Query app's demo project: a small trading domain with everything the query
// builder has to handle -- classes with docs, enumerations, to-one and to-many
// navigation, a derived property, a relational mapping over joins, a runtime whose
// H2 connection seeds itself, a data space with two execution contexts and curated
// executables, a service and a function.

###Pure
Profile demo::trading::Governance
{
  stereotypes: [certified, deprecated];
  tags: [owner, sensitivity];
}

Enum {meta::pure::profiles::doc.doc = 'Where a firm is headquartered.'} demo::trading::Region
{
  AMER,
  EMEA,
  APAC
}

Enum {meta::pure::profiles::doc.doc = 'Direction of a trade.'} demo::trading::Side
{
  BUY,
  SELL
}

Enum {meta::pure::profiles::doc.doc = 'Broad classification of a traded product.'} demo::trading::AssetClass
{
  EQUITY,
  RATES,
  CREDIT,
  FX
}

Class <<demo::trading::Governance.certified>> {meta::pure::profiles::doc.doc = 'A legal entity that employs traders.', demo::trading::Governance.owner = 'reference-data'} demo::trading::Firm
{
  {meta::pure::profiles::doc.doc = 'Stable numeric identifier.'} firmId: Integer[1];
  {meta::pure::profiles::doc.doc = 'Registered legal name.'} legalName: String[1];
  {meta::pure::profiles::doc.doc = 'Headquarters region.'} region: demo::trading::Region[1];
  {meta::pure::profiles::doc.doc = 'Date of incorporation, when known.'} founded: StrictDate[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A person employed by a firm; traders book trades.'} demo::trading::Person
{
  personId: Integer[1];
  firstName: String[1];
  lastName: String[1];
  {meta::pure::profiles::doc.doc = 'Job title, when recorded.'} title: String[0..1];
  age: Integer[0..1];
  {meta::pure::profiles::doc.doc = 'First and last name.'} fullName() {$this.firstName + ' ' + $this.lastName}: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A tradable instrument.'} demo::trading::Product
{
  ticker: String[1];
  name: String[1];
  assetClass: demo::trading::AssetClass[1];
}

Class <<demo::trading::Governance.certified>> {meta::pure::profiles::doc.doc = 'An executed trade.', demo::trading::Governance.sensitivity = 'internal'} demo::trading::Trade
{
  tradeId: Integer[1];
  tradeDate: StrictDate[1];
  side: demo::trading::Side[1];
  quantity: Integer[1];
  {meta::pure::profiles::doc.doc = 'Execution price per unit.'} price: Float[1];
  status: String[1];
  {meta::pure::profiles::doc.doc = 'Quantity times price.'} notional() {$this.quantity->toFloat() * $this.price}: Float[1];
}

Association demo::trading::Firm_Employees
{
  firm: demo::trading::Firm[0..1];
  employees: demo::trading::Person[*];
}

Association demo::trading::Trade_Trader
{
  trader: demo::trading::Person[0..1];
  trades: demo::trading::Trade[*];
}

Association demo::trading::Trade_Product
{
  product: demo::trading::Product[0..1];
  productTrades: demo::trading::Trade[*];
}

function {meta::pure::profiles::doc.doc = 'Every trade with its trader and product, as a relation.'} demo::trading::tradeBlotter(): Any[*]
{
  demo::trading::Trade.all()
    ->project(~[
      tradeId: x|$x.tradeId,
      tradeDate: x|$x.tradeDate,
      side: x|$x.side,
      ticker: x|$x.product.ticker,
      trader: x|$x.trader.lastName,
      quantity: x|$x.quantity,
      price: x|$x.price
    ])
}

###Relational
Database demo::trading::DB
(
  Schema TRADING
  (
    Table FIRM (FIRM_ID INTEGER PRIMARY KEY, LEGAL_NAME VARCHAR(128), REGION VARCHAR(8), FOUNDED DATE)
    Table PERSON (PERSON_ID INTEGER PRIMARY KEY, FIRST_NAME VARCHAR(64), LAST_NAME VARCHAR(64), TITLE VARCHAR(64), AGE INTEGER, FIRM_ID INTEGER)
    Table PRODUCT (TICKER VARCHAR(16) PRIMARY KEY, NAME VARCHAR(128), ASSET_CLASS VARCHAR(16))
    Table TRADE (TRADE_ID INTEGER PRIMARY KEY, TRADE_DATE DATE, SIDE VARCHAR(4), QUANTITY INTEGER, PRICE DOUBLE, STATUS VARCHAR(16), TICKER VARCHAR(16), TRADER_ID INTEGER)
  )

  Join PersonFirm(TRADING.PERSON.FIRM_ID = TRADING.FIRM.FIRM_ID)
  Join TradeTrader(TRADING.TRADE.TRADER_ID = TRADING.PERSON.PERSON_ID)
  Join TradeProduct(TRADING.TRADE.TICKER = TRADING.PRODUCT.TICKER)
)

###Mapping
Mapping demo::trading::TradingMapping
(
  demo::trading::Region: EnumerationMapping RegionMapping
  {
    AMER: 'AMER',
    EMEA: 'EMEA',
    APAC: 'APAC'
  }
  demo::trading::Side: EnumerationMapping SideMapping
  {
    BUY: 'BUY',
    SELL: 'SELL'
  }
  demo::trading::AssetClass: EnumerationMapping AssetClassMapping
  {
    EQUITY: 'EQUITY',
    RATES: 'RATES',
    CREDIT: 'CREDIT',
    FX: 'FX'
  }

  *demo::trading::Firm: Relational
  {
    ~primaryKey ([demo::trading::DB] TRADING.FIRM.FIRM_ID)
    ~mainTable [demo::trading::DB] TRADING.FIRM
    firmId: [demo::trading::DB] TRADING.FIRM.FIRM_ID,
    legalName: [demo::trading::DB] TRADING.FIRM.LEGAL_NAME,
    region: EnumerationMapping RegionMapping: [demo::trading::DB] TRADING.FIRM.REGION,
    founded: [demo::trading::DB] TRADING.FIRM.FOUNDED,
    employees: [demo::trading::DB] @PersonFirm
  }

  *demo::trading::Person: Relational
  {
    ~primaryKey ([demo::trading::DB] TRADING.PERSON.PERSON_ID)
    ~mainTable [demo::trading::DB] TRADING.PERSON
    personId: [demo::trading::DB] TRADING.PERSON.PERSON_ID,
    firstName: [demo::trading::DB] TRADING.PERSON.FIRST_NAME,
    lastName: [demo::trading::DB] TRADING.PERSON.LAST_NAME,
    title: [demo::trading::DB] TRADING.PERSON.TITLE,
    age: [demo::trading::DB] TRADING.PERSON.AGE,
    firm: [demo::trading::DB] @PersonFirm,
    trades: [demo::trading::DB] @TradeTrader
  }

  *demo::trading::Product: Relational
  {
    ~primaryKey ([demo::trading::DB] TRADING.PRODUCT.TICKER)
    ~mainTable [demo::trading::DB] TRADING.PRODUCT
    ticker: [demo::trading::DB] TRADING.PRODUCT.TICKER,
    name: [demo::trading::DB] TRADING.PRODUCT.NAME,
    assetClass: EnumerationMapping AssetClassMapping: [demo::trading::DB] TRADING.PRODUCT.ASSET_CLASS,
    productTrades: [demo::trading::DB] @TradeProduct
  }

  *demo::trading::Trade: Relational
  {
    ~primaryKey ([demo::trading::DB] TRADING.TRADE.TRADE_ID)
    ~mainTable [demo::trading::DB] TRADING.TRADE
    tradeId: [demo::trading::DB] TRADING.TRADE.TRADE_ID,
    tradeDate: [demo::trading::DB] TRADING.TRADE.TRADE_DATE,
    side: EnumerationMapping SideMapping: [demo::trading::DB] TRADING.TRADE.SIDE,
    quantity: [demo::trading::DB] TRADING.TRADE.QUANTITY,
    price: [demo::trading::DB] TRADING.TRADE.PRICE,
    status: [demo::trading::DB] TRADING.TRADE.STATUS,
    trader: [demo::trading::DB] @TradeTrader,
    product: [demo::trading::DB] @TradeProduct
  }
)

###Connection
RelationalDatabaseConnection demo::trading::H2Connection
{
  store: demo::trading::DB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'DROP SCHEMA IF EXISTS TRADING CASCADE;',
      'CREATE SCHEMA TRADING;',
      'CREATE TABLE TRADING.FIRM (FIRM_ID INTEGER PRIMARY KEY, LEGAL_NAME VARCHAR(128), REGION VARCHAR(8), FOUNDED DATE);',
      'CREATE TABLE TRADING.PERSON (PERSON_ID INTEGER PRIMARY KEY, FIRST_NAME VARCHAR(64), LAST_NAME VARCHAR(64), TITLE VARCHAR(64), AGE INTEGER, FIRM_ID INTEGER);',
      'CREATE TABLE TRADING.PRODUCT (TICKER VARCHAR(16) PRIMARY KEY, NAME VARCHAR(128), ASSET_CLASS VARCHAR(16));',
      'CREATE TABLE TRADING.TRADE (TRADE_ID INTEGER PRIMARY KEY, TRADE_DATE DATE, SIDE VARCHAR(4), QUANTITY INTEGER, PRICE DOUBLE, STATUS VARCHAR(16), TICKER VARCHAR(16), TRADER_ID INTEGER);',
      'INSERT INTO TRADING.FIRM VALUES (1, \'Meridian Capital\', \'AMER\', \'1998-04-01\'), (2, \'Halberd Securities\', \'EMEA\', \'2004-09-15\'), (3, \'Kestrel Partners\', \'APAC\', NULL), (4, \'Northgate Asset Management\', \'AMER\', \'2011-01-20\');',
      'INSERT INTO TRADING.PERSON VALUES (1, \'Maria\', \'Alvarez\', \'Managing Director\', 48, 1), (2, \'Kenji\', \'Watanabe\', \'Vice President\', 37, 3), (3, \'Aoife\', \'O\'\'Brien\', \'Executive Director\', 42, 2), (4, \'Peter\', \'Nowak\', \'Analyst\', 26, 2), (5, \'Sofia\', \'Rossi\', NULL, 31, 1), (6, \'David\', \'Chen\', \'Associate\', NULL, 4), (7, \'Amara\', \'Okafor\', \'Vice President\', 35, 4), (8, \'Lukas\', \'Schmidt\', \'Analyst\', 24, NULL);',
      'INSERT INTO TRADING.PRODUCT VALUES (\'AAPL\', \'Apple Inc\', \'EQUITY\'), (\'MSFT\', \'Microsoft Corp\', \'EQUITY\'), (\'UKT30\', \'UK Gilt 4.25% 2055\', \'RATES\'), (\'UST10\', \'US Treasury 10Y\', \'RATES\'), (\'EURUSD\', \'Euro / US Dollar\', \'FX\'), (\'ITRX\', \'iTraxx Europe Main\', \'CREDIT\');',
      'INSERT INTO TRADING.TRADE VALUES (1, \'2024-06-03\', \'BUY\', 1000, 190.5, \'EXECUTED\', \'AAPL\', 1), (2, \'2024-06-03\', \'SELL\', 2500, 191.0, \'EXECUTED\', \'AAPL\', 2), (3, \'2024-06-04\', \'BUY\', 400, 418.25, \'EXECUTED\', \'MSFT\', 3), (4, \'2024-06-04\', \'BUY\', 1200, 415.0, \'SETTLED\', \'MSFT\', 1), (5, \'2024-06-05\', \'SELL\', 5000000, 0.9825, \'EXECUTED\', \'UKT30\', 3), (6, \'2024-06-05\', \'BUY\', 2000000, 0.98, \'PENDING\', \'UKT30\', 4), (7, \'2024-06-06\', \'BUY\', 10000000, 1.0842, \'EXECUTED\', \'EURUSD\', 5), (8, \'2024-06-06\', \'SELL\', 7500000, 1.0851, \'CANCELLED\', \'EURUSD\', 7), (9, \'2024-06-07\', \'BUY\', 3000000, 99.12, \'EXECUTED\', \'UST10\', 6), (10, \'2024-06-07\', \'SELL\', 25000000, 0.55, \'EXECUTED\', \'ITRX\', 7), (11, \'2024-06-10\', \'BUY\', 800, 192.75, \'EXECUTED\', \'AAPL\', 5), (12, \'2024-06-10\', \'SELL\', 600, 420.1, \'REJECTED\', \'MSFT\', NULL);'
    ];
  };
  auth: DefaultH2;
}

###Runtime
Runtime demo::trading::H2Runtime
{
  mappings:
  [
    demo::trading::TradingMapping
  ];
  connections:
  [
    demo::trading::DB:
    [
      h2: demo::trading::H2Connection
    ]
  ];
}

###Service
Service {meta::pure::profiles::doc.doc = 'Executed equity trades.'} demo::trading::ExecutedEquityTrades
{
  pattern: '/demo/trades/equity';
  documentation: 'Executed equity trades with trader and firm.';
  execution: Single
  {
    query: |demo::trading::Trade.all()
      ->filter(x|($x.status == 'EXECUTED') && ($x.product.assetClass == demo::trading::AssetClass.EQUITY))
      ->project(~[
        tradeId: x|$x.tradeId,
        ticker: x|$x.product.ticker,
        side: x|$x.side,
        quantity: x|$x.quantity,
        price: x|$x.price,
        trader: x|$x.trader.lastName,
        firm: x|$x.trader.firm.legalName
      ]);
    mapping: demo::trading::TradingMapping;
    runtime: demo::trading::H2Runtime;
  }
}

###DataSpace
DataSpace <<demo::trading::Governance.certified>> {meta::pure::profiles::doc.doc = 'Trading reference and activity data.'} demo::trading::TradingDataSpace
{
  executionContexts:
  [
    {
      name: 'Production';
      title: 'Production (H2)';
      description: 'Trades, traders, firms and products from the trading database.';
      mapping: demo::trading::TradingMapping;
      defaultRuntime: demo::trading::H2Runtime;
    }
  ];
  defaultExecutionContext: 'Production';
  title: 'Trading';
  description: '# Trading\nEvery **trade** booked by our traders, with the **product** traded and the **firm** each trader works for.\n\nStart from *Trade* for activity, or from *Firm* / *Person* for reference data.';
  elements:
  [
    demo::trading
  ];
  executables:
  [
    {
      id: blotter;
      title: 'Trade blotter';
      description: 'Every trade with its trader and product.';
      query: |demo::trading::Trade.all()->project(~[tradeId: x|$x.tradeId, tradeDate: x|$x.tradeDate, side: x|$x.side, ticker: x|$x.product.ticker, trader: x|$x.trader.lastName, quantity: x|$x.quantity, price: x|$x.price]);
      executionContextKey: 'Production';
    },
    {
      id: by_firm;
      title: 'Headcount by firm';
      description: 'How many people each firm employs.';
      query: |demo::trading::Person.all()->project(~[firm: x|$x.firm.legalName, person: x|$x.personId])->groupBy(~[firm], ~[headcount: x|$x.person: y|$y->count()]);
      executionContextKey: 'Production';
    },
    {
      title: 'Executed equity trades';
      description: 'The certified service.';
      executable: demo::trading::ExecutedEquityTrades;
    }
  ];
  supportInfo: Email {
    documentationUrl: 'https://legend.finos.org';
    address: 'trading-data@example.org';
  };
}
